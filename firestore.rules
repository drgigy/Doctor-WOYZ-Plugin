rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          "drgigy@gmail.com"
        ];
    }

    function allowedDeviceCreate(deviceId) {
      return signedIn()
        && request.resource.data.keys().hasAll([
          "id",
          "ownerUid",
          "status"
        ])
        && request.resource.data.id == deviceId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "pending"
        && (!("label" in request.resource.data) || request.resource.data.label is string)
        && (!("userName" in request.resource.data) || request.resource.data.userName is string)
        && (!("userAgent" in request.resource.data) || request.resource.data.userAgent is string);
    }

    match /deviceApprovals/{deviceId} {
      allow create: if allowedDeviceCreate(deviceId);
      allow get: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if isAdmin();
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == "pending"
        && request.resource.data.status == "pending"
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["userName"])
        && request.resource.data.userName is string;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "status",
          "authorizationKey",
          "authorizationKeyAssignedAt",
          "approvedAt",
          "approvedBy",
          "revokedAt",
          "label"
        ])
        && request.resource.data.status in ["pending", "approved", "revoked"];
      allow delete: if isAdmin();
    }

    match /appConfig/authorization {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
